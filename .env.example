# Copy this file to .env and adjust values for your environment.

# Server
PORT=4000

# JWT signing secret — CHANGE THIS in production to a long random string.
JWT_SECRET=kisan-sathi-dev-secret-change-me
JWT_EXPIRES_IN=7d

# Turso / libSQL database (SQLite-compatible, persists on serverless).
# Create one:  turso db create kisan-sathi
#   URL   ->   turso db show --url kisan-sathi     (looks like libsql://xxx.turso.io)
#   token ->   turso db tokens create kisan-sathi
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Public base URL used when embedding links inside generated QR codes.
# In production set this to your Vercel domain, e.g. https://your-app.vercel.app
PUBLIC_BASE_URL=http://localhost:4000

# Google Gemini API — powers real AI disease detection (and AI chat replies).
# Get a free key at https://aistudio.google.com/app/apikey  (no credit card).
# Leave blank to use the built-in demo/stub diagnosis instead.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
